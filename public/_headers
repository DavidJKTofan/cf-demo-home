# Prevent workers.dev preview URLs from being indexed
https://:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Security headers for all routes
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: document-domain=()

# Aggressive caching for hashed/fingerprinted static assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep this anonymous sandbox asset under the zone's existing /_astro/ Precursor exclusion.
/_astro/client-side-security/skimmer-test.js
  ! Cache-Control
  Content-Type: application/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: no-store
