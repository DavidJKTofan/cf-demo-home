{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cf-demo-home",
	// Re-export Astro's handler and the demo's Durable Object from the same Worker.
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"browser": {
		"binding": "BROWSER"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "CLIENT_SIDE_SECURITY_RUNS", "class_name": "ClientSideSecurityRun" }
		]
	},
	"migrations": [
		{ "tag": "client-side-security-v1", "new_sqlite_classes": ["ClientSideSecurityRun"] }
	],
	"ratelimits": [
		{
			"name": "BROWSER_RUN_LIMITER",
			"namespace_id": "842501",
			"simple": {
				"limit": 1,
				"period": 10
			}
		}
	],
	// Disable the workers.dev subdomain — serve only via the custom domain
	"workers_dev": false,
	// Disable per-deployment preview URLs
	"preview_urls": false,
	// Custom domain routing
	"routes": [
		{
			"pattern": "automatic-demo.com",
			"custom_domain": true
		}
	],
	"assets": {
		// astro build outputs static assets to dist/client (server Worker to dist/server)
		"directory": "./dist/client",
		"binding": "ASSETS",
		// Return the nearest 404.html for unmatched static-asset routes
		"not_found_handling": "404-page",
		// An explicit list routes every other path directly to assets. Include ALL dynamic endpoints.
		"run_worker_first": [
			"/api/*",
			"/_image",
			"/_server-islands/*",
			"/demos/security/client-side-security-change-test.js",
			"/_astro/client-side-security/sample",
			"/_astro/client-side-security/sample/"
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			// Capture 100% of requests in production
			"head_sampling_rate": 1
		}
	}
}
