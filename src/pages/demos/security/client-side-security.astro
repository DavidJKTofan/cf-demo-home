<script is:inline>
  (() => {
    const run = new URLSearchParams(location.search).get('run');
    const script = document.createElement('script');
    script.src = '/demos/security/client-side-security-change-test.js' +
      (run && /^[a-f0-9]{32}$/.test(run) ? '?run=' + run : '');
    script.onerror = () => {
      document.querySelector('#signal-status').textContent = 'The published script could not load; the run may have expired.';
    };
    document.head.appendChild(script);
  })();
</script>

<script is:inline>
  (() => {
    const parameters = new URLSearchParams(window.location.search);
    if (parameters.get('malicious') !== '1') return;

    const status = document.querySelector('#sample-status');
    const result = document.querySelector('#sample-result');
    if (result) result.hidden = false;
    if (status) status.textContent = 'Hosted skimmer sample requested; waiting for load confirmation.';
    const frame = document.createElement('iframe');
    frame.src = '/_astro/client-side-security/sample';
    frame.title = 'Isolated skimmer test with synthetic checkout values';
    frame.setAttribute('sandbox', 'allow-scripts');
    frame.style.cssText = 'width:100%;height:180px;border:1px solid var(--border);border-radius:6px;margin-top:12px';
    window.addEventListener('message', (event) => {
      if (event.source !== frame.contentWindow || event.data?.type !== 'client-side-security-sample') return;
      if (event.data.state === 'loaded' && status) status.textContent = 'Hosted skimmer sample loaded in its isolated frame; inspect Cloudflare classification.';
      if (event.data.state === 'error' && status) status.textContent = 'The hosted skimmer sample did not load.';
    });
    result.appendChild(frame);
  })();
</script>

<script>
  import { initializeBrowserControls } from '../../../lib/client-side-security/browser-controls';
  initializeBrowserControls();
</script>
